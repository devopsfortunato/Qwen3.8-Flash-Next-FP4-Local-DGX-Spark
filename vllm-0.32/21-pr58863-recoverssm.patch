+            convs = [fc[name].kv_cache[0] for name in self.layer_names]
+            ctx = _PleConvCommit(
+                convs, 1 + self.num_spec, self.vllm_config.scheduler_config.max_num_seqs
+            )
+            self._ctx = ctx
+            logger.info(
+                "PLE RecoverSSM commit context: %d layers, history %d",
+                len(convs),
+                ctx.hist,
+            )
