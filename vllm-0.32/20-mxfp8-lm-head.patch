 from vllm.platforms import current_platform
 
+logger = init_logger(__name__)
+
 DEFAULT_VOCAB_PADDING_SIZE = 64
 
 
+def _supports_default_lm_head_quantization(
+    recipe: Literal["mxfp8"],
+    params_dtype: torch.dtype,
+    input_size: int,
+    output_size: int,
+) -> bool:
+    """Whether an unquantized LM head shard can runtime-quantize to `recipe`.
+
+    Mirrors the eligibility checks of the fork's VLLM_MXFP8_LM_HEAD: BF16
+    model, shard shapes the b12x MXFP8 GEMM accepts unchanged, the b12x
+    linear backend selected, on a Blackwell 12x device.
+    """
+    from vllm.config import get_current_vllm_config
+
+    config = get_current_vllm_config()
+    if (
+        config.model_config is None
+        or config.model_config.dtype != torch.bfloat16
+        or params_dtype != torch.bfloat16
+        or input_size % 128
+        or output_size % 8
+        or config.kernel_config.linear_backend not in ("auto", "b12x")
+        or not current_platform.is_cuda()
+        or not current_platform.is_device_capability_family(120)
+    ):
+        return False
+
+    from vllm.model_executor.kernels.linear import init_mxfp8_linear_kernel
+    from vllm.model_executor.kernels.linear.mxfp8.b12x import B12xMxfp8LinearKernel
+
+    try:
+        kernel = init_mxfp8_linear_kernel(weight_shape=(output_size, input_size))
+    except ValueError:
+        return False
+    return isinstance(kernel, B12xMxfp8LinearKernel)
+
+
 class UnquantizedEmbeddingMethod(QuantizeMethodBase):
     """Unquantized method for embeddings."""
 
@@ -93,6 +134,19 @@ class UnquantizedEmbeddingMethod(QuantizeMethodBase):
         return layer
 
 
+class _LMHeadBF16Source(UnquantizedEmbeddingMethod):
+    """Loads a BF16 LM head exactly as an unquantized one, for runtime requantization.
+
+    The online MXFP8 method's own meta-device loading does not fit the vocab-parallel
+    loader (padded rows), so the head loads through this method and is quantized once,
+    after loading, from the real BF16 tensor.
+    """
+
+    def dequantize_weight(self, layer: torch.nn.Module) -> torch.Tensor:
+        return layer.weight
+
+
+
 def pad_vocab_size(vocab_size: int, pad_to: int = DEFAULT_VOCAB_PADDING_SIZE) -> int:
     """Pad the vocab size to the given value."""
     return ((vocab_size + pad_to - 1) // pad_to) * pad_to
@@ -264,6 +318,7 @@ class VocabParallelEmbedding(PluggableLayer):
         reduce_results: bool = True,
         quant_method: QuantizeMethodBase | None = None,
         parallel_group: GroupCoordinator | None = None,
+        lm_head_quantization: Literal["mxfp8"] | None = None,
     ):
         super().__init__()
 
@@ -321,6 +376,54 @@ class VocabParallelEmbedding(PluggableLayer):
         if quant_method is None:
             quant_method = UnquantizedEmbeddingMethod()
 
+        # Runtime MXFP8 LM head quantization (opt-in via VLLM_MXFP8_LM_HEAD).
+        # Applies only to ParallelLMHead with a plain BF16 checkpoint head on
+        # Blackwell 12x; the b12x MXFP8 GEMM reads BF16 activations directly,
+        # so logits keep the model dtype while the weight shards are stored
+        # (and GEMMed) as MXFP8 with block-32 scales.
+        head_quantization = lm_head_quantization
+        if head_quantization is None and envs.VLLM_MXFP8_LM_HEAD:
+            head_quantization = "mxfp8"
+        self.runtime_lm_head_quantization: Literal["mxfp8"] | None = None
+        if head_quantization is not None and isinstance(self, ParallelLMHead):
+            from vllm.config import get_current_vllm_config
+            from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+            from vllm.model_executor.layers.quantization.online.mxfp8 import (
+                Mxfp8OnlineLinearMethod,
+            )
+
+            unquantized = isinstance(
+                quant_method, (UnquantizedEmbeddingMethod, UnquantizedLinearMethod)
+            )
+            model_config = get_current_vllm_config().model_config
+            tied = getattr(
+                getattr(model_config, "hf_text_config", None),
+                "tie_word_embeddings",
+                False,
+            )
+            default_supported = _supports_default_lm_head_quantization(
+                head_quantization,
+                params_dtype or torch.get_default_dtype(),
+                embedding_dim,
+                self.num_embeddings_per_partition,
+            )
+            if not envs.is_set("VLLM_MXFP8_LM_HEAD") and (
+                not unquantized or tied or not default_supported
+            ):
+                head_quantization = None
+            elif not unquantized:
+                raise ValueError(
+                    "Runtime LM head quantization requires an unquantized "
+                    "LM head checkpoint"
+                )
+            if head_quantization == "mxfp8":
+                quant_method = Mxfp8OnlineLinearMethod()
+                quant_method.set_requantization_source(_LMHeadBF16Source())
+                self.runtime_lm_head_quantization = head_quantization
+                logger.info_once(
+                    "Quantizing LM head shards to MXFP8 with BF16 activations."
+                )
+
         # If we are making an embedding layer, then our quantization linear
         # method must implement the embedding operation. If we are another
         # layer type like ParallelLMHead, this is not important.
@@ -609,6 +712,7 @@ class ParallelLMHead(VocabParallelEmbedding):
         *,
         disable_tp: bool = False,
         quant_method: QuantizeMethodBase | None = None,
+        lm_head_quantization: Literal["mxfp8"] | None = None,
     ):
         self.has_bias = bias
         super().__init__(
@@ -621,6 +725,7 @@ class ParallelLMHead(VocabParallelEmbedding):
             prefix,
             disable_tp=disable_tp,
             quant_method=quant_method,
+            lm_head_quantization=lm_head_quantization,
         )
         self.quant_config = quant_config
         if bias:
