# PROFILE=kv-max ./start.sh
# The default 262,144-token window with the largest KV cache measured on one DGX Spark:
# a 34 GB pool, 1,719,161 FP8 tokens (6.6 full-window requests at once) against 1,575,180 (31.15 GB) for
# the default. Lowest MemAvailable while serving: 4.4 GiB, so leave nothing else big running on the box
# (lower KV_CACHE_MEMORY_BYTES if you do). Read as KEY=value data; .env and the environment win.
KV_CACHE_MEMORY_BYTES=34000000000
# Six full windows fit in the pool, so six requests decode at once, each with room for a full window
# (the default decodes 8 at once in a pool that holds 6).
MAX_NUM_SEQS=6
# With the pool allocated the server sits near 6 GiB MemAvailable, too close to the default 6 GiB floor.
MEM_FLOOR_GIB=4
