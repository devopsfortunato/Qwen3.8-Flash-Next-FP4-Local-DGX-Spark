# PROFILE=kv-max ./start.sh
# The default 262,144-token window with the largest KV cache measured on one DGX Spark:
# a 34 GB pool, 1,719,161 FP8 tokens (6.6 full-window requests at once) against about 1.0-1.1M for the
# default. Lowest MemAvailable while serving: 5.5 GiB, so leave nothing else big running on the box
# (lower KV_CACHE_MEMORY_BYTES if you do). Read as KEY=value data; .env and the environment win.
KV_CACHE_MEMORY_BYTES=34000000000
# With the pool allocated the server sits near 6 GiB MemAvailable, under the default 8 GiB floor.
MEM_FLOOR_GIB=4
