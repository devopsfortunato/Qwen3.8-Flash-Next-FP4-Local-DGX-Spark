# PROFILE=kv-max ./start.sh
# The default 262,144-token window with the largest KV cache measured on one DGX Spark:
# a 28 GB pool, 1,415,809 FP8 tokens (5.4 full-window requests at once) against 1.1M for the default.
# Lowest MemAvailable while serving: 11.4 GiB. Read as KEY=value data; .env and the environment win.
KV_CACHE_MEMORY_BYTES=28000000000
