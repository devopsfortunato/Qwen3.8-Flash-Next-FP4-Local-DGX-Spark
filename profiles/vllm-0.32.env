# PROFILE=vllm-0.32 ./start.sh — upstream vLLM v0.32.0 lane.
# Build the image first on the Spark: vllm-0.32/build.sh (see vllm-0.32/README.md).
# Read as KEY=value data; .env and the environment win.

# The tag build.sh gives the image: the 12-hex prefix of the patched source tree
# (tag v0.32.0 + vllm-0.32/series). It exists only locally, so prepare.sh must not pull it.
IMAGE=qwen38-flash-next-fp4:vllm-0.32.0-85567e46546a
PULL=0

# PLE n-gram tables off the GPU: the regular lane's engram host-file gather
# replaces the fork's VLLM_PLE_TABLE_MEMORY=disk, which upstream vLLM does not
# have.
ENGRAM_CONFIG={"host_file_gather":true}

# No --gdn-decode-kernel: upstream v0.32.0 has no such flag; the GDN decode
# path the flag selected in the fork is not part of this lane.
GDN_DECODE_KERNEL=

# Fork-only container variables the upstream image must not receive. Everything
# else in the default SPARK_ENV exists in v0.32.0 and stays
# (CUTE_DSL_ARCH, VLLM_B12X_MOE_FP4_FORCE_A16, VLLM_USE_AOT_COMPILE,
# VLLM_USE_MEGA_AOT_ARTIFACT, VLLM_USE_V2_MODEL_RUNNER, VLLM_SSM_CONV_STATE_LAYOUT, ...).
SPARK_ENV_OMIT="VLLM_PLE_TABLE_MEMORY B12X_DISK_BACKEND B12X_POLICY_MODE VLLM_MXFP8_LM_HEAD VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE B12X_W4A16_A4_PREFILL B12X_W4A16_A4_PREFILL_TERMS VLLM_B12X_DENSE_ACTIVATION_MODE PLE_QUEUE_DEPTH"

# --load-format b12x stays opt-in on this lane (Qwen4Exp checkpoints only, TP
# without EP/DP/PP). Drop the line to load through the default safetensors path;
# CSF block scales decode either way.
LOAD_FORMAT=b12x
