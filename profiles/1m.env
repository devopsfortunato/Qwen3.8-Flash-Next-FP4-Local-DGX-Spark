# PROFILE=1m ./start.sh
# A 1,048,576-token window: YaRN rope scaling 4x over the checkpoint's 262,144 positions, and a 30 GB
# FP8 KV pool, 1,931,132 tokens (1.84 full-window requests at once). Test profile: see README, Profiles,
# for the quality and needle results at this length. Read as KEY=value data; .env and the environment win.
MAX_MODEL_LEN=1048576
YARN_FACTOR=4
KV_CACHE_MEMORY_BYTES=30000000000
# With the pool allocated the server sits near 7.8 GiB MemAvailable, under the default 8 GiB floor.
MEM_FLOOR_GIB=4
