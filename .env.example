# Copy to .env and uncomment the lines you want to change.
# .env is KEY=value, read and never executed. The environment wins:
#   PORT=9000 ./start.sh
# HF_TOKEN is forwarded into the container by name. It is not printed by DRY_RUN=1.

# HF_TOKEN=
# PROFILE=          # kv-max or 1m, from profiles/
# MODEL_ID=nvidia/Qwen3.8-Flash-Next-FP4-Local
# IMAGE=eugr/spark-vllm-b12x:latest
# PORT=8000
# HOST=0.0.0.0
# SERVED_NAME=nvidia/Qwen3.8-Flash-Next-FP4-Local
# MAX_MODEL_LEN=262144
# MAX_NUM_SEQS=8
# MAX_NUM_BATCHED_TOKENS=4096
# GPU_MEMORY_UTILIZATION=0.8
# KV_CACHE_MEMORY_BYTES=
# YARN_FACTOR=
# KV_CACHE_DTYPE=fp8
# QUANTIZATION=modelopt_mixed
# LOAD_FORMAT=b12x
# MTP_TOKENS=3
# BLOCK_SIZE=16
# DTYPE=bfloat16
# VLLM_PLE_TABLE_MEMORY=disk
# B12X_DISK_BACKEND=io_uring
# CUTE_DSL_ARCH=sm_121a
# HF_CACHE=
# MEM_NEED_GIB=90
# MEM_FLOOR_GIB=8
# MEM_FLOOR_GRACE=30
# MEM_HARD_FLOOR_GIB=2
# MEM_CHECK=1
# MIN_FREE_GB=120
# IMAGE_FREE_GB=30
# CONTAINER_NAME=qwen38-flash-next-fp4
# WAIT_TIMEOUT=1800
# PREPARE=auto
# PULL=1
# HF_HUB_OFFLINE=1
